Config/llm_config.yaml

# ── Generated documents ──
~$*.docx

# ── Workflow runtime state ──
07_Workflows/reports/
07_Workflows/workflow_state.json

# ── Build artifacts ──
*.tsbuildinfo

# ── External source dependencies (cloned repos) ──
external/

